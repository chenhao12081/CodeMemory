# Copy this file to .env, then replace the two API key placeholders.

# Bundled MySQL service (docker compose)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=codememory
DB_PASSWORD=codememory
DB_DATABASE=codememory

# Ollama models. The base Qwen model makes the public demo reproducible;
# you can replace it with your fine-tuned intent model.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3

# DeepSeek answer/evidence model
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Create a serverless Pinecone index with dimension=1024 and metric=cosine.
PINECONE_API_KEY=replace-with-your-pinecone-api-key
PINECONE_INDEX_NAME=codememory-demo

# Public sample corpus included in this repository.
CORPUS_DIR=examples/corpus

# Reproducible local reranker defaults. Increase only after measuring latency.
RAG_RERANKER_ENABLED=true
RAG_RERANKER_TOP_K=10
RAG_RERANKER_MAX_LENGTH=512
RAG_CONTEXT_TOP_K=4

# E2E judge defaults
E2E_JUDGE_MODEL=deepseek-chat
